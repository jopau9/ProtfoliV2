# Formulari del diagnòstic (/serveis). Plantilla: copia-la a .env.local en local
# (aquest fitxer es versiona: no hi posis valors reals) i posa els mateixos
# valors a Vercel: Settings → Environment Variables.

# Contrasenya d'aplicació de Google (myaccount.google.com/apppasswords; cal tenir
# activada la verificació en dos passos). Els espais no importen.
GMAIL_APP_PASSWORD=

# El compte de Gmail des del qual s'envia. Per defecte, el correu de content/site.ts.
GMAIL_USER=

# On arriben les sol·licituds. Per defecte, el mateix compte.
AUDIT_TO_EMAIL=
