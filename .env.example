# Formulari d'auditoria (/serveis). Copia'l a .env.local en local
# i posa els mateixos valors a Vercel: Settings → Environment Variables.

# Clau de l'API de Resend (resend.com → API Keys).
RESEND_API_KEY=

# On arriben les sol·licituds. Per defecte, el correu de content/site.ts.
AUDIT_TO_EMAIL=

# Remitent. Sense un domini verificat a Resend, deixa'l buit: s'usarà
# onboarding@resend.dev, que només pot enviar al correu del titular del compte.
AUDIT_FROM_EMAIL=
